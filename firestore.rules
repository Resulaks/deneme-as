rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yonetici = e-posta/sifre ile giris yapmis herkes
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Siparis alimi kapatildiysa (settings/shop.closed = true) yeni siparis yazilamaz
    function shopOpen() {
      let p = /databases/$(database)/documents/settings/shop;
      return !exists(p) || get(p).data.get('closed', false) != true;
    }

    // Dukkan bilgileri: herkes okur, sadece yonetici degistirir
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{id} {
      allow create: if shopOpen()
        && request.resource.data.status == 'Yeni'
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.total is number
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 60;
      allow read, update, delete: if isAdmin();
    }
  }
}
