rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yönetici: Authentication'da e-posta/şifre ile oluşturduğunuz hesaplar.
    // Birden fazla yönetici için e-postaları virgülle ekleyin. KÜÇÜK HARFLE yazın.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == '001596'
        && request.auth.token.email.lower() in ['sıparıs001@gmaıl.com'];
    }

    // Menü: herkes okur, sadece yönetici değiştirir
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Siparişler: müşteri sipariş oluşturabilir, sadece yönetici görür/yönetir
    match /orders/{id} {
      allow create: if request.resource.data.status == 'Yeni'
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.total is number
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 60;
      allow read, update, delete: if isAdmin();
    }
  }
}
