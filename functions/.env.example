# Bu dosyayı ".env" adıyla kopyalayıp doldurun. ".env" dosyası GitHub'a GÖNDERİLMEZ (.gitignore'da).
# Değişiklikten sonra: firebase deploy --only functions

# Fonksiyonların bölgesi, Firestore konumunuzla uyumlu olmalıdır.
#   Firestore "eur3" ise  -> europe-west1
#   Firestore "nam5" ise  -> us-central1
#   Tek bölgeyse (örn. europe-west3) -> aynısını yazın
FUNCTION_REGION=europe-west1

# Hangi kanal kullanılacak:  netgsm  (SMS)   |   whatsapp   |   boş = gönderme
NOTIFY_PROVIDER=netgsm

# Panelde dükkan adı yoksa kullanılacak ad
SHOP_NAME=Ağa Döner

# ---- SMS (Netgsm) ----
NETGSM_USER=
NETGSM_PASS=
# Netgsm panelinde onaylı gönderen başlığınız
NETGSM_HEADER=

# ---- WhatsApp Business (Meta Cloud API) ----
WA_TOKEN=
WA_PHONE_ID=
# Meta'da onaylatılan şablonun adı ve dili (şablon 3 değişkenli olmalı, README'ye bakın)
WA_TEMPLATE=siparis_durumu
WA_LANG=tr
